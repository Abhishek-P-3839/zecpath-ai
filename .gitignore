# virtual environment
venv/
.venv/

# python files
__pycache__/
*.pyc
.pytest_cache/

# logs (keep the folder, not the log files)
logs/*.log
logs/*.log.*

# secrets and local settings
.env

# real candidate data should never be pushed
data/*
!data/sample_resume.txt
!data/README.md
!data/schemas/
!data/samples/
!data/raw_resumes/
!data/raw_resumes/*
!data/extracted/
!data/extracted/*
!data/job_descriptions/
!data/job_descriptions/*
!data/parsed_jobs/
!data/parsed_jobs/*

# Day 7: pipeline storage holds real candidate data -> never push (data/* already ignores it)
data/store/
!data/samples/pipeline_example/
!data/samples/pipeline_example/**

# Day 8: labeled resume samples (dummy data) are a deliverable -> push them.
# data/segmented/ (output of run_section_demo.py) can hold real candidate data -> stays ignored.
!data/labeled_resumes/
!data/labeled_resumes/*

# Day 9: data/skills/ (output of run_skill_demo.py) can hold real candidate data -> stays ignored.
# data/samples/sample_skills_output.json is dummy data and is pushed.

# private project notes (for me and Claude only, never pushed)
*.private.md


# Day 11: data/education/ (output of run_education_demo.py) is generated from the DUMMY sample resumes in
# data/raw_resumes -> the sample outputs are a deliverable and are pushed. Real candidate resumes must
# never be placed in data/raw_resumes.
!data/education/
!data/education/*

# Day 12: matching accuracy outputs come from the DUMMY sample resumes and are a deliverable -> push them.
# data/samples/matching_ground_truth.json is already covered by !data/samples/ above.
!data/matching/
!data/matching/*
